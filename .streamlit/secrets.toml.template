# Paste this into Streamlit Cloud App -> Settings -> Secrets.
# Replace placeholder values with the real credential values.

# Numeric GA4 property ID for the Advanced Manufacturing app analytics property.
GA_PROPERTY_ID = "432233519"

[ga4_service_account]
type = "service_account"
project_id = "YOUR_GOOGLE_CLOUD_PROJECT_ID"
private_key_id = "YOUR_PRIVATE_KEY_ID"
private_key = """
-----BEGIN PRIVATE KEY-----
YOUR_GA4_SERVICE_ACCOUNT_PRIVATE_KEY
-----END PRIVATE KEY-----
"""
# You may also paste only the key body; the app will add the PEM wrapper.
client_email = "your-service-account@your-project.iam.gserviceaccount.com"
client_id = "YOUR_CLIENT_ID"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "https://www.googleapis.com/robot/v1/metadata/x509/YOUR_SERVICE_ACCOUNT_EMAIL"
universe_domain = "googleapis.com"

[google_play]
enabled = true
auth_mode = "service_account"
bucket_id = "pubsite_prod_0000000000000000000"
package_name = "com.smemedia.android"
report_object_template = "stats/installs/installs_{package_name}_{year_month}_country.csv"
encoding = "utf-16"
metric_column = "Daily User Installs"
report_date_column = "Date"

[google_play.service_account]
type = "service_account"
project_id = "YOUR_GOOGLE_CLOUD_PROJECT_ID"
private_key_id = "YOUR_PRIVATE_KEY_ID"
private_key = """
-----BEGIN PRIVATE KEY-----
YOUR_GOOGLE_PLAY_SERVICE_ACCOUNT_PRIVATE_KEY
-----END PRIVATE KEY-----
"""
# You may also paste only the key body; the app will add the PEM wrapper.
client_email = "your-service-account@your-project.iam.gserviceaccount.com"
client_id = "YOUR_CLIENT_ID"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "https://www.googleapis.com/robot/v1/metadata/x509/YOUR_SERVICE_ACCOUNT_EMAIL"
universe_domain = "googleapis.com"

[app_store]
enabled = true
key_type = "team"
key_id = "YOUR_APP_STORE_CONNECT_KEY_ID"
issuer_id = "YOUR_APP_STORE_CONNECT_ISSUER_ID"
vendor_number = "YOUR_VENDOR_NUMBER"
report_subtype = "SUMMARY"
report_type = "SALES"
version = "1_0"
encoding = "utf-8-sig"
units_column = "Units"
product_type_identifiers = ["1", "1F", "1T"]
skus = ["com.smemedia.ios"]
apple_ids = ["6494275046"]
private_key = """
-----BEGIN PRIVATE KEY-----
YOUR_APP_STORE_CONNECT_P8_PRIVATE_KEY
-----END PRIVATE KEY-----
"""
# You may also paste only the key body; the app will add the PEM wrapper.
